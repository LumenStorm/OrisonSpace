{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/desktop/agent": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts",
      "ignore": ["src/**/*.test.ts"]
    },
    "apps/desktop/client/shell": {
      "entry": [
        "main/index.ts",
        "preload/index.ts",
        "renderer/main.tsx"
      ],
      "project": ["main/**/*.ts", "preload/**/*.ts", "renderer/**/*.{ts,tsx}"],
      "ignore": ["**/*.test.ts"]
    },
    "apps/desktop/client/ui": {
      "entry": ["src/app/App.tsx"],
      "project": "src/**/*.{ts,tsx}",
      "ignore": ["src/**/*.{test,spec}.{ts,tsx}"]
    },
    "apps/desktop/local-bff": {
      "entry": ["index.ts"],
      "project": "**/*.ts",
      "ignore": ["**/*.test.ts"]
    },
    "packages/shared-contracts": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts",
      "ignore": ["src/**/*.test.ts"]
    },
    "packages/model-protocols": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts",
      "ignore": ["src/**/*.test.ts"]
    },
    "packages/story-sync": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts",
      "ignore": ["src/**/*.test.ts"]
    }
  },
  "ignore": ["**/dist/**"],
  "ignoreDependencies": ["@swc/core", "bcrypt"]
}
