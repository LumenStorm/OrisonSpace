{
  "name": "orison-space",
  "version": "0.3.0",
  "private": true,
  "description": "开源、本地优先的 AI 小说创作 IDE — 大纲/章节/资产卡一体化，AI 生成·续写·润色·审阅，接入任意 OpenAI 兼容模型。Open-source, local-first AI novel-writing IDE.",
  "keywords": [
    "ai",
    "novel-writing",
    "creative-writing",
    "ai-writing",
    "writing-tool",
    "ide",
    "local-first",
    "electron",
    "react",
    "typescript",
    "llm",
    "openai",
    "agent",
    "desktop-app",
    "web-novel"
  ],
  "homepage": "https://github.com/LumenStorm/OrisonSpace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumenStorm/OrisonSpace.git"
  },
  "bugs": {
    "url": "https://github.com/LumenStorm/OrisonSpace/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.27.7",
      "zod": "^3.24.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @orison/desktop-shell dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @orison/desktop-shell build",
    "package:desktop": "pnpm --filter @orison/desktop-shell dist",
    "package:desktop:portable": "pnpm --filter @orison/desktop-shell pack:portable",
    "package:desktop:dir": "pnpm --filter @orison/desktop-shell pack:dir",
    "test": "turbo run test",
    "lint": "eslint . && depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip",
    "typecheck": "turbo run typecheck",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "knip": "^6.18.0",
    "turbo": "^2.0.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8",
    "vitest": "^3.1.4"
  }
}
