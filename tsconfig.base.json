{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@orison/shared-contracts": [
        "./packages/shared-contracts/src/index.ts"
      ],
      "@orison/shared-contracts/*": [
        "./packages/shared-contracts/src/*"
      ],
      "@orison/model-protocols": [
        "./packages/model-protocols/src/index.ts"
      ],
      "@orison/model-protocols/*": [
        "./packages/model-protocols/src/*"
      ],
      "@orison/story-sync": [
        "./packages/story-sync/src/index.ts"
      ],
      "@orison/story-sync/*": [
        "./packages/story-sync/src/*"
      ],
      "@orison/desktop-agent": [
        "./apps/desktop/agent/src/index.ts"
      ],
      "@orison/desktop-agent/*": [
        "./apps/desktop/agent/src/*"
      ]
    }
  }
}
